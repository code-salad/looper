#!/usr/bin/env bash
set -euo pipefail

# git-loop-context — Read loop history from git log
# Usage: git-loop-context --task <name> --iteration <N>
# Outputs structured markdown with plan, changes, and verdict per prior iteration.

TASK=""
ITERATION=""

while [[ $# -gt 0 ]]; do
    case "$1" in
        --task) TASK="$2"; shift 2 ;;
        --iteration) ITERATION="$2"; shift 2 ;;
        *) echo "Unknown option: $1" >&2; exit 1 ;;
    esac
done

if [ -z "$TASK" ] || [ -z "$ITERATION" ]; then
    echo "Usage: git-loop-context --task <name> --iteration <N>" >&2
    exit 1
fi

echo "## Loop Context: ${TASK}, Iteration ${ITERATION}"
echo ""

# If iteration 1, note that there's no prior context and exit early
if [ "$ITERATION" -eq 1 ]; then
    echo "This is the first iteration. No prior context available."
    echo ""
    exit 0
fi

# Fetch all loop commits in a single git log call
# Each commit is delimited by __COMMIT__ markers with hash, phase, iteration, and body
ALL_LOG=$(git log --grep="Loop-Iteration:" --format="__COMMIT__%H%n%B__END__" 2>/dev/null || true)

# For each prior iteration, extract the relevant commits from the combined log
for (( i=1; i<ITERATION; i++ )); do
    echo "### Iteration ${i}"
    echo ""

    # Extract plan commit body for this iteration
    plan_body=$(echo "$ALL_LOG" | awk -v iter="$i" '
        /^__COMMIT__/ { hash=substr($0,11); body=""; in_commit=1; is_plan=0; is_iter=0; next }
        /^__END__$/ {
            if (in_commit && is_plan && is_iter) print body
            in_commit=0; next
        }
        in_commit {
            if ($0 ~ "^Loop-Phase: plan$") is_plan=1
            if ($0 ~ "^Loop-Iteration: " iter "$") is_iter=1
            body = (body == "" ? $0 : body "\n" $0)
        }
    ')
    if [ -n "$plan_body" ]; then
        echo "#### Plan"
        echo ""
        echo "$plan_body" | sed '/^Loop-Phase:/d; /^Loop-Iteration:/d; /^Loop-Verdict:/d'
        echo ""
    fi

    # Extract doer commit hash and body for this iteration
    doer_info=$(echo "$ALL_LOG" | awk -v iter="$i" '
        /^__COMMIT__/ { hash=substr($0,11); body=""; in_commit=1; is_do=0; is_iter=0; next }
        /^__END__$/ {
            if (in_commit && is_do && is_iter) print "HASH:" hash "\n" body
            in_commit=0; next
        }
        in_commit {
            if ($0 ~ "^Loop-Phase: do$") is_do=1
            if ($0 ~ "^Loop-Iteration: " iter "$") is_iter=1
            body = (body == "" ? $0 : body "\n" $0)
        }
    ')
    if [ -n "$doer_info" ]; then
        doer_hash=$(echo "$doer_info" | head -1 | sed 's/^HASH://')
        doer_body=$(echo "$doer_info" | tail -n +2)
        echo "#### Changes"
        echo ""
        echo "$doer_body" | sed '/^Loop-Phase:/d; /^Loop-Iteration:/d; /^Loop-Verdict:/d'
        echo ""
        echo "**Files changed:**"
        echo '```'
        git show --stat --format="" "$doer_hash" 2>/dev/null || true
        echo '```'
        echo ""
    fi

    # Extract checker verdict body for this iteration
    verdict_body=$(echo "$ALL_LOG" | awk -v iter="$i" '
        /^__COMMIT__/ { hash=substr($0,11); body=""; in_commit=1; is_check=0; is_iter=0; next }
        /^__END__$/ {
            if (in_commit && is_check && is_iter) print body
            in_commit=0; next
        }
        in_commit {
            if ($0 ~ "^Loop-Phase: check$") is_check=1
            if ($0 ~ "^Loop-Iteration: " iter "$") is_iter=1
            body = (body == "" ? $0 : body "\n" $0)
        }
    ')
    if [ -n "$verdict_body" ]; then
        verdict=$(echo "$verdict_body" | grep -oE 'Loop-Verdict: (PASS|FAIL)' | head -1 | sed 's/Loop-Verdict: //' || echo "UNKNOWN")
        echo "#### Verdict: ${verdict}"
        echo ""
        echo "$verdict_body" | sed '/^Loop-Phase:/d; /^Loop-Iteration:/d; /^Loop-Verdict:/d'
        echo ""
    fi

    echo "---"
    echo ""
done
