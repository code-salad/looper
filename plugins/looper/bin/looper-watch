#!/usr/bin/env bash
set -euo pipefail

# Auto-downloads the looper-watch binary from GitHub Releases.
# Caches by version so it only downloads once per release.

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PLUGIN_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
REPO="code-salad/looper"
BINARY_NAME="looper-watch"

# Read version from plugin.json
VERSION=$(jq -r '.version' "$PLUGIN_ROOT/.claude-plugin/plugin.json" 2>/dev/null || echo "")
if [ -z "$VERSION" ]; then
    echo "[${BINARY_NAME}] ERROR: Could not read version from plugin.json" >&2
    exit 1
fi

CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/looper/bin/v${VERSION}"
BIN="$CACHE_DIR/$BINARY_NAME"

if [ ! -x "$BIN" ]; then
    echo "[${BINARY_NAME}] Downloading v${VERSION}..." >&2
    mkdir -p "$CACHE_DIR"

    URL="https://github.com/${REPO}/releases/download/v${VERSION}/${BINARY_NAME}-x86_64-linux.tar.gz"

    if ! curl -fsSL "$URL" | tar xz -C "$CACHE_DIR"; then
        echo "[${BINARY_NAME}] ERROR: Failed to download from $URL" >&2
        echo "[${BINARY_NAME}] Build locally: cargo build -p ${BINARY_NAME} --release" >&2
        rm -rf "$CACHE_DIR"
        exit 1
    fi

    chmod +x "$BIN"
    echo "[${BINARY_NAME}] Downloaded v${VERSION} to $BIN" >&2
fi

exec "$BIN" "$@"
