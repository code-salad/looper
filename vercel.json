{
  "version": 2,
  "buildCommand": "cd dashboard && npm install",
  "outputDirectory": "dashboard/public",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/index.js": {
      "memory": 256,
      "maxDuration": 30,
      "includeFiles": "dashboard/**"
    }
  }
}
